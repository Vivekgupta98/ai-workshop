# Local workshop configuration. scripts/start-judge0.sh replaces the two
# password placeholders when it creates the ignored judge0.conf file.
JUDGE0_TELEMETRY_ENABLE=false
ENABLE_WAIT_RESULT=true
ENABLE_COMPILER_OPTIONS=true
ALLOW_ENABLE_NETWORK=false
ENABLE_NETWORK=false

COUNT=2
MAX_QUEUE_SIZE=20

REDIS_HOST=redis
REDIS_PASSWORD=__REDIS_PASSWORD__

POSTGRES_HOST=db
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

CPU_TIME_LIMIT=2
MAX_CPU_TIME_LIMIT=5
CPU_EXTRA_TIME=1
MAX_CPU_EXTRA_TIME=2
WALL_TIME_LIMIT=5
MAX_WALL_TIME_LIMIT=10
MEMORY_LIMIT=512000
MAX_MEMORY_LIMIT=512000
STACK_LIMIT=64000
MAX_STACK_LIMIT=128000
MAX_PROCESSES_AND_OR_THREADS=60
MAX_MAX_PROCESSES_AND_OR_THREADS=60
MAX_FILE_SIZE=1024
MAX_MAX_FILE_SIZE=1024
NUMBER_OF_RUNS=1
MAX_NUMBER_OF_RUNS=1

RAILS_ENV=production
